.board { width:1024px; height:600px; position:relative; background-color:#101923; color:#f1efe9; }
.brand { position:absolute; left:20px; top:10px; font-size:20px; height:28px; color:#d4dded; }
.clock { position:absolute; right:20px; top:10px; width:324px; height:28px; font-size:20px; text-align:right; color:#d4dded; }
.photo-stage { position:absolute; left:20px; top:44px; width:640px; height:360px; background-color:#080e14; }
.photo { position:absolute; }
.photo-caption { position:absolute; left:20px; top:410px; width:984px; font-size:16px; height:24px; color:#aab7c5; }
.usage { position:absolute; left:680px; top:44px; width:324px; height:360px; background-color:#1c2b3b; border-radius:12px; }
.usage-label { position:absolute; left:20px; top:28px; font-size:18px; color:#aab7c5; height:26px; }
.label { font-size:18px; color:#aab7c5; height:26px; }
.remaining { position:absolute; left:20px; top:86px; font-size:76px; height:104px; color:#c4e5bc; }
.reset-time { position:absolute; left:20px; top:206px; width:290px; font-size:17px; height:28px; color:#d4dded; }
.reset-countdown { position:absolute; left:20px; top:239px; width:290px; font-size:18px; height:28px; color:#c4e5bc; }
.usage-note { position:absolute; left:20px; top:279px; font-size:15px; height:24px; color:#aab7c5; }
.usage-detail { position:absolute; left:20px; top:317px; font-size:15px; height:24px; color:#97a8ba; }
.strategy { position:absolute; left:20px; top:442px; width:984px; height:154px; }
.headline { position:absolute; left:0px; top:30px; width:984px; font-size:27px; line-height:34px; height:36px; }
.focus { position:absolute; left:0px; top:74px; width:470px; font-size:18px; line-height:24px; height:48px; color:#d4dded; }
.commitment { position:absolute; left:494px; top:74px; width:490px; font-size:18px; line-height:24px; height:48px; color:#aab7c5; }
.footer { position:absolute; left:20px; top:577px; height:20px; font-size:13px; color:#97a8ba; }
.todo { position:absolute; width:312px; height:28px; font-size:16px; line-height:28px; color:#d4dded; }
.left { left:0px; }
.middle { left:336px; }
.right { left:672px; }
.row1 { top:32px; }
.row2 { top:62px; }
.row3 { top:92px; }
.row4 { top:122px; }
